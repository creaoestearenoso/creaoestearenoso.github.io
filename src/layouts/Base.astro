---
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = 'Zona Oeste Arenoso de CREA — los grupos del oeste bonaerense.' } = Astro.props;
const actual = Astro.url.pathname.replace(/\/$/, '') || '/';

const secciones = [
  { href: '/', texto: 'Inicio' },
  { href: '/la-zona', texto: 'La zona' },
  { href: '/contacto', texto: 'Contacto' },
];
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#008751" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400;700&display=swap"
    />
    <title>{titulo} · Zona CREA Oeste Arenoso</title>
  </head>
  <body>
    <header class="encabezado">
      <div class="contenedor">
        <a class="marca" href="/"><b>CREA</b><span>OESTE ARENOSO</span></a>
        <nav class="navegacion">
          {secciones.map((s) => (
            <a
              href={s.href}
              aria-current={actual === s.href.replace(/\/$/, '') || (s.href === '/' && actual === '/') ? 'page' : undefined}
            >{s.texto}</a>
          ))}
        </nav>
      </div>
    </header>

    <slot name="portada" />

    <main>
      <div class="contenedor">
        <slot />
      </div>
    </main>

    <footer class="pie">
      <div class="contenedor">
        <p>Zona Oeste Arenoso — Consorcios Regionales de Experimentación Agrícola.</p>
        <p>Oeste de la provincia de Buenos Aires.</p>
      </div>
    </footer>
  </body>
</html>
