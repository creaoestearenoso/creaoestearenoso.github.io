---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const novedades = await getCollection('novedades');
  return novedades.map((n) => ({ params: { id: n.id }, props: { novedad: n } }));
}

const { novedad } = Astro.props;
const { Content } = await render(novedad);

const formato = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base titulo={novedad.data.titulo} descripcion={novedad.data.resumen}>
  <article>
    <p class="fecha">{formato.format(novedad.data.fecha)}</p>
    <h1>{novedad.data.titulo}</h1>
    <Content />
  </article>
  <p style="margin-top:3rem"><a href="/novedades">← Volver a novedades</a></p>
</Base>
