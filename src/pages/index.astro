---
import Base from '../layouts/Base.astro';
---

<Base titulo="Inicio">
  <section class="portada" slot="portada">
    <div class="contenedor">
      <h1>Trabajar la arena, juntos</h1>
      <p class="bajada">
        Los grupos CREA del oeste bonaerense comparten una condición de suelo y una manera
        de trabajar: medir, comparar y contarse los resultados.
      </p>
    </div>
  </section>

  <ul class="accesos">
    <li>
      <a href="/la-zona">
        <h2>La zona</h2>
        <p>Los grupos que la integran, las autoridades y la coordinación.</p>
      </a>
    </li>
    <li>
      <a href="/contacto">
        <h2>Contacto</h2>
        <p>Por dónde llega una consulta o una propuesta de trabajo.</p>
      </a>
    </li>
  </ul>
</Base>
